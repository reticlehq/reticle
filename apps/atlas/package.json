{
  "name": "@reticlehq/atlas",
  "version": "3.10.2",
  "private": true,
  "description": "The hard fixture: a logistics console with server-authoritative state, push updates, virtualization and a branching flow — built to find what Reticle cannot see.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "ATLAS_DEMO=1 VITE_RETICLE_ALLOW_NON_LOCALHOST=1 vite build --mode development",
    "start": "node --experimental-strip-types --no-warnings server/serve.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@reticlehq/browser": "workspace:*",
    "@reticlehq/react": "workspace:*",
    "@reticlehq/vite-plugin": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.7.3",
    "vite": "^8.2.1"
  }
}
