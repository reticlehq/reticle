{
  "name": "@reticlehq/electron-smoke",
  "version": "3.7.0",
  "private": true,
  "description": "A real Electron app (Vite + React renderer, contextBridge IPC) to smoke-test Reticle on Electron.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -s first \"vite\" \"wait-on tcp:5174 && electron .\"",
    "dev:packaged": "vite build --mode development && cross-env RETICLE_DEMO_FILE=1 electron .",
    "typecheck": "tsc -b"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@reticlehq/browser": "workspace:*",
    "@reticlehq/react": "workspace:*",
    "@reticlehq/vite-plugin": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.8.0",
    "vite": "^7.3.7",
    "wait-on": "^9.5.1",
    "@reticlehq/electron": "workspace:*"
  }
}
