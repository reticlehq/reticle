{
  "name": "@reticlehq/openreality",
  "version": "3.0.0",
  "description": "The Open Verification Protocol: the vocabulary, the rules and the interface an implementation answers, so that \"it works\" can be checked from outside the thing claiming it.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/*.json": "./dist/schema/*.json"
  },
  "files": [
    "dist",
    "README.md",
    "SPEC.md",
    "GOVERNANCE.md"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/gen-schema.mjs",
    "prepack": "tsc -b && node scripts/gen-schema.mjs && node ../scripts/prepare-dist.mjs dist",
    "test:unit": "vitest run --passWithNoTests",
    "test:guards": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "zod-to-json-schema": "^3.23.5"
  }
}
