{
  "$id": "https://openreality.dev/schema/v1/belief.json",
  "$ref": "#/definitions/belief",
  "definitions": {
    "belief": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["invariant", "failure-mode", "gap", "repair-outcome"]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "object",
          "properties": {
            "class": {
              "type": "string",
              "enum": ["authoritative", "derived", "observed", "learned"]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "subject": {
              "type": "object",
              "properties": {
                "surface": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": ["web", "desktop", "mobile", "service", "game", "device"]
                    },
                    {
                      "type": "string",
                      "minLength": 1
                    }
                  ]
                },
                "instance": {
                  "type": "string",
                  "minLength": 1
                },
                "epoch": {
                  "type": "integer",
                  "minimum": 0
                },
                "locator": {
                  "type": "string"
                },
                "revision": {
                  "type": "string"
                }
              },
              "required": ["surface", "instance"],
              "additionalProperties": false
            },
            "at": {
              "type": "integer"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": ["class", "source", "method", "subject", "at"],
          "additionalProperties": false
        },
        "observations": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "promotedBy": {
          "type": "string"
        },
        "promotedAt": {
          "type": "integer"
        }
      },
      "required": ["id", "kind", "statement", "provenance"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
