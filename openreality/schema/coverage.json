{
  "$id": "https://openreality.dev/schema/v1/coverage.json",
  "$ref": "#/definitions/coverage",
  "definitions": {
    "coverage": {
      "type": "object",
      "properties": {
        "window": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "ui",
                  "net",
                  "state",
                  "signal",
                  "log",
                  "route",
                  "storage",
                  "time",
                  "visual"
                ]
              },
              {
                "type": "string",
                "pattern": "^x-[a-z0-9-]+$"
              }
            ]
          }
        },
        "blindSpots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "channel-unobserved",
                  "boundary-uncrossable",
                  "buffer-truncated",
                  "redacted",
                  "still-in-flight",
                  "effect-elsewhere"
                ]
              },
              "channel": {
                "$ref": "#/definitions/coverage/properties/observed/items"
              },
              "detail": {
                "type": "string",
                "minLength": 1
              },
              "impeaching": {
                "type": "boolean"
              },
              "remedy": {
                "type": "string"
              }
            },
            "required": ["kind", "detail", "impeaching"],
            "additionalProperties": false
          }
        }
      },
      "required": ["window", "observed", "blindSpots"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
