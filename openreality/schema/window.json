{
  "$id": "https://openreality.dev/schema/v1/window.json",
  "$ref": "#/definitions/window",
  "definitions": {
    "window": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "openedAt": {
          "type": "integer"
        },
        "closedAt": {
          "type": "integer"
        },
        "budgetMs": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "closes": {
          "type": "string",
          "enum": ["quiescence", "ticks", "ack", "signal", "settled-physical", "budget-exhausted"]
        },
        "closedBy": {
          "type": "string",
          "enum": ["quiescence", "ticks", "ack", "signal", "settled-physical", "budget-exhausted"]
        },
        "subject": {
          "type": "object",
          "properties": {
            "surface": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": ["web", "desktop", "mobile", "service", "game", "device"]
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            "instance": {
              "type": "string",
              "minLength": 1
            },
            "epoch": {
              "type": "integer",
              "minimum": 0
            },
            "locator": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "required": ["surface", "instance"],
          "additionalProperties": false
        }
      },
      "required": ["id", "openedAt", "budgetMs", "closes", "subject"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
