{
  "$id": "https://openreality.dev/schema/v1/verification-run.json",
  "$ref": "#/definitions/verification-run",
  "definitions": {
    "verification-run": {
      "type": "object",
      "properties": {
        "ovp": {
          "type": "string",
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "verifier": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "profile": {
              "type": "string"
            }
          },
          "required": ["name", "version"],
          "additionalProperties": false
        },
        "subject": {
          "type": "object",
          "properties": {
            "surface": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": ["web", "desktop", "mobile", "service", "game", "device"]
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            "instance": {
              "type": "string",
              "minLength": 1
            },
            "epoch": {
              "type": "integer",
              "minimum": 0
            },
            "locator": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "required": ["surface", "instance"],
          "additionalProperties": false
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "ui",
                      "net",
                      "state",
                      "signal",
                      "log",
                      "route",
                      "storage",
                      "time",
                      "visual"
                    ]
                  },
                  {
                    "type": "string",
                    "pattern": "^x-[a-z0-9-]+$"
                  }
                ]
              },
              "independence": {
                "type": "string",
                "enum": ["independent", "actuation-derived"]
              },
              "grade": {
                "type": "string",
                "enum": ["consequence", "presence", "context"]
              },
              "note": {
                "type": "string"
              }
            },
            "required": ["id", "independence", "grade"],
            "additionalProperties": false
          }
        },
        "intents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "origin": {
                "type": "string",
                "enum": ["user", "developer", "agent", "system", "workflow", "derived"]
              },
              "status": {
                "type": "string",
                "enum": ["declared", "bound", "abandoned"]
              },
              "claims": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "abandonedBecause": {
                "type": "string"
              },
              "declaredAt": {
                "type": "integer"
              }
            },
            "required": ["id", "statement", "origin", "status"],
            "additionalProperties": false
          },
          "default": []
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "intent": {
                "type": "string"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "declaredAt": {
                "type": "string",
                "enum": ["before-action", "after-action"]
              },
              "assertions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "predicate": {},
                    "reads": {
                      "type": "string",
                      "minLength": 1
                    },
                    "channels": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/verification-run/properties/channels/items/properties/id"
                      },
                      "minItems": 1
                    }
                  },
                  "required": ["id", "reads", "channels"],
                  "additionalProperties": false
                },
                "default": []
              }
            },
            "required": ["id", "statement", "declaredAt"],
            "additionalProperties": false
          },
          "default": []
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "predicate": {},
              "channels": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/verification-run/properties/channels/items/properties/id"
                },
                "minItems": 1
              },
              "severity": {
                "type": "string",
                "enum": ["blocking", "advisory"],
                "default": "blocking"
              }
            },
            "required": ["id", "statement", "channels"],
            "additionalProperties": false
          },
          "default": []
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "actor": {
                "type": "string",
                "minLength": 1
              },
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string"
              },
              "parameters": {},
              "at": {
                "type": "integer"
              }
            },
            "required": ["id", "actor", "capability", "at"],
            "additionalProperties": false
          },
          "default": []
        },
        "receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1
              },
              "dispatched": {
                "type": "boolean"
              },
              "refused": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "enum": [
                      "undeclared",
                      "unsupported",
                      "unresolved",
                      "unavailable",
                      "guarded",
                      "malformed"
                    ]
                  },
                  "detail": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["reason", "detail"],
                "additionalProperties": false
              },
              "subject": {
                "$ref": "#/definitions/verification-run/properties/subject"
              },
              "at": {
                "type": "integer"
              }
            },
            "required": ["action", "dispatched", "subject", "at"],
            "additionalProperties": false
          },
          "default": []
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "openedAt": {
                "type": "integer"
              },
              "closedAt": {
                "type": "integer"
              },
              "budgetMs": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "closes": {
                "type": "string",
                "enum": [
                  "quiescence",
                  "ticks",
                  "ack",
                  "signal",
                  "settled-physical",
                  "budget-exhausted"
                ]
              },
              "closedBy": {
                "type": "string",
                "enum": [
                  "quiescence",
                  "ticks",
                  "ack",
                  "signal",
                  "settled-physical",
                  "budget-exhausted"
                ]
              },
              "subject": {
                "$ref": "#/definitions/verification-run/properties/subject"
              }
            },
            "required": ["id", "openedAt", "budgetMs", "closes", "subject"],
            "additionalProperties": false
          },
          "default": []
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "observation": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "window": {
                    "type": "string",
                    "minLength": 1
                  },
                  "channel": {
                    "$ref": "#/definitions/verification-run/properties/channels/items/properties/id"
                  },
                  "at": {
                    "type": "integer"
                  },
                  "value": {},
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["id", "window", "channel", "at", "summary"],
                "additionalProperties": false
              },
              "provenance": {
                "type": "object",
                "properties": {
                  "class": {
                    "type": "string",
                    "enum": ["authoritative", "derived", "observed", "learned"]
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "method": {
                    "type": "string",
                    "minLength": 1
                  },
                  "subject": {
                    "$ref": "#/definitions/verification-run/properties/subject"
                  },
                  "at": {
                    "type": "integer"
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": ["class", "source", "method", "subject", "at"],
                "additionalProperties": false
              },
              "independence": {
                "type": "string",
                "enum": ["independent", "actuation-derived"]
              },
              "grade": {
                "type": "string",
                "enum": ["consequence", "presence", "context"]
              }
            },
            "required": ["observation", "provenance", "independence", "grade"],
            "additionalProperties": false
          },
          "default": []
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "window": {
                "type": "string",
                "minLength": 1
              },
              "observed": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/verification-run/properties/channels/items/properties/id"
                }
              },
              "blindSpots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "channel-unobserved",
                        "boundary-uncrossable",
                        "buffer-truncated",
                        "redacted",
                        "still-in-flight",
                        "effect-elsewhere"
                      ]
                    },
                    "channel": {
                      "$ref": "#/definitions/verification-run/properties/channels/items/properties/id"
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 1
                    },
                    "impeaching": {
                      "type": "boolean"
                    },
                    "remedy": {
                      "type": "string"
                    }
                  },
                  "required": ["kind", "detail", "impeaching"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["window", "observed", "blindSpots"],
            "additionalProperties": false
          },
          "default": []
        },
        "anomalies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "advanced-over-failure",
                      "claimed-over-failure",
                      "effect-discarded",
                      "claim-uncorroborated",
                      "failure-inside-success",
                      "value-not-applied",
                      "duplicated-effect",
                      "stale-applied",
                      "no-effect",
                      "fault-misattributed",
                      "evidence-superseded",
                      "evidence-predates-edit"
                    ]
                  },
                  {
                    "type": "string",
                    "pattern": "^x-[a-z0-9-]+$"
                  }
                ]
              },
              "tier": {
                "type": "string",
                "enum": ["observed", "absence-derived", "advisory"]
              },
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "counter": {
                "type": "string",
                "minLength": 1
              },
              "between": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": [
                  {
                    "$ref": "#/definitions/verification-run/properties/channels/items/properties/id"
                  },
                  {
                    "$ref": "#/definitions/verification-run/properties/channels/items/properties/id"
                  }
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            },
            "required": ["kind", "tier", "claim", "counter", "between"],
            "additionalProperties": false
          },
          "default": []
        },
        "verdicts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "window": {
                "type": "string",
                "minLength": 1
              },
              "verdict": {
                "type": "string",
                "enum": ["yes", "no", "unknown", "no-fault"]
              },
              "grade": {
                "type": "string",
                "enum": ["consequence", "presence", "context"]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "default": []
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "anomalies": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/verification-run/properties/anomalies/items"
                },
                "default": []
              },
              "supersedes": {
                "type": "string"
              },
              "at": {
                "type": "integer"
              }
            },
            "required": ["id", "claim", "window", "verdict", "at"],
            "additionalProperties": false
          },
          "default": []
        },
        "repairs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "verdict": {
                "type": "string",
                "minLength": 1
              },
              "expected": {
                "type": "string",
                "minLength": 1
              },
              "actual": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "location": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer"
                  },
                  "symbol": {
                    "type": "string"
                  }
                },
                "required": ["file"],
                "additionalProperties": false
              },
              "instruction": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["verdict", "expected", "actual", "evidence", "instruction"],
            "additionalProperties": false
          },
          "default": []
        },
        "startedAt": {
          "type": "integer"
        },
        "endedAt": {
          "type": "integer"
        }
      },
      "required": ["ovp", "id", "verifier", "subject", "channels", "startedAt", "endedAt"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
