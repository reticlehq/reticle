{
  "$id": "https://openreality.dev/schema/v1/channel-descriptor.json",
  "$ref": "#/definitions/channel-descriptor",
  "definitions": {
    "channel-descriptor": {
      "type": "object",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["ui", "net", "state", "signal", "log", "route", "storage", "time", "visual"]
            },
            {
              "type": "string",
              "pattern": "^x-[a-z0-9-]+$"
            }
          ]
        },
        "independence": {
          "type": "string",
          "enum": ["independent", "actuation-derived"]
        },
        "grade": {
          "type": "string",
          "enum": ["consequence", "presence", "context"]
        },
        "note": {
          "type": "string"
        }
      },
      "required": ["id", "independence", "grade"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
