{
  "$id": "https://openreality.dev/schema/v1/implementation.json",
  "$ref": "#/definitions/implementation",
  "definitions": {
    "implementation": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "claims": {
          "type": "string",
          "enum": ["effect", "in-realm", "surface"]
        },
        "homepage": {
          "type": "string"
        }
      },
      "required": ["name", "version", "platform", "claims"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
