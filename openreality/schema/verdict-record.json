{
  "$id": "https://openreality.dev/schema/v1/verdict-record.json",
  "$ref": "#/definitions/verdict-record",
  "definitions": {
    "verdict-record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "window": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "type": "string",
          "enum": ["yes", "no", "unknown", "no-fault"]
        },
        "grade": {
          "type": "string",
          "enum": ["consequence", "presence", "context"]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "anomalies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "advanced-over-failure",
                      "claimed-over-failure",
                      "effect-discarded",
                      "claim-uncorroborated",
                      "failure-inside-success",
                      "value-not-applied",
                      "duplicated-effect",
                      "stale-applied",
                      "no-effect",
                      "fault-misattributed",
                      "evidence-superseded",
                      "evidence-predates-edit"
                    ]
                  },
                  {
                    "type": "string",
                    "pattern": "^x-[a-z0-9-]+$"
                  }
                ]
              },
              "tier": {
                "type": "string",
                "enum": ["observed", "absence-derived", "advisory"]
              },
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "counter": {
                "type": "string",
                "minLength": 1
              },
              "between": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": [
                  {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "ui",
                          "net",
                          "state",
                          "signal",
                          "log",
                          "route",
                          "storage",
                          "time",
                          "visual"
                        ]
                      },
                      {
                        "type": "string",
                        "pattern": "^x-[a-z0-9-]+$"
                      }
                    ]
                  },
                  {
                    "$ref": "#/definitions/verdict-record/properties/anomalies/items/properties/between/items/0"
                  }
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            },
            "required": ["kind", "tier", "claim", "counter", "between"],
            "additionalProperties": false
          },
          "default": []
        },
        "supersedes": {
          "type": "string"
        },
        "at": {
          "type": "integer"
        }
      },
      "required": ["id", "claim", "window", "verdict", "at"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
