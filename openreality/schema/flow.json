{
  "$id": "https://openreality.dev/schema/v1/flow.json",
  "$ref": "#/definitions/flow",
  "definitions": {
    "flow": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "actor": {
                "type": "string",
                "minLength": 1
              },
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string"
              },
              "parameters": {},
              "at": {
                "type": "integer"
              }
            },
            "required": ["id", "actor", "capability", "at"],
            "additionalProperties": false
          }
        },
        "expects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "predicate": {},
              "reads": {
                "type": "string",
                "minLength": 1
              },
              "channels": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "ui",
                        "net",
                        "state",
                        "signal",
                        "log",
                        "route",
                        "storage",
                        "time",
                        "visual"
                      ]
                    },
                    {
                      "type": "string",
                      "pattern": "^x-[a-z0-9-]+$"
                    }
                  ]
                },
                "minItems": 1
              }
            },
            "required": ["id", "reads", "channels"],
            "additionalProperties": false
          },
          "default": []
        },
        "mayRebind": {
          "type": "boolean",
          "default": false
        }
      },
      "required": ["name", "version", "claim", "steps"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
