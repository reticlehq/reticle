{
  "$id": "https://openreality.dev/schema/v1/action-receipt.json",
  "$ref": "#/definitions/action-receipt",
  "definitions": {
    "action-receipt": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "dispatched": {
          "type": "boolean"
        },
        "refused": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "enum": [
                "undeclared",
                "unsupported",
                "unresolved",
                "unavailable",
                "guarded",
                "malformed"
              ]
            },
            "detail": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["reason", "detail"],
          "additionalProperties": false
        },
        "subject": {
          "type": "object",
          "properties": {
            "surface": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": ["web", "desktop", "mobile", "service", "game", "device"]
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            "instance": {
              "type": "string",
              "minLength": 1
            },
            "epoch": {
              "type": "integer",
              "minimum": 0
            },
            "locator": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "required": ["surface", "instance"],
          "additionalProperties": false
        },
        "at": {
          "type": "integer"
        }
      },
      "required": ["action", "dispatched", "subject", "at"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
