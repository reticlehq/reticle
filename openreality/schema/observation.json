{
  "$id": "https://openreality.dev/schema/v1/observation.json",
  "$ref": "#/definitions/observation",
  "definitions": {
    "observation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "window": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["ui", "net", "state", "signal", "log", "route", "storage", "time", "visual"]
            },
            {
              "type": "string",
              "pattern": "^x-[a-z0-9-]+$"
            }
          ]
        },
        "at": {
          "type": "integer"
        },
        "value": {},
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["id", "window", "channel", "at", "summary"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
