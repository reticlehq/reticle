{
  "$id": "https://openreality.dev/schema/v1/provenance.json",
  "$ref": "#/definitions/provenance",
  "definitions": {
    "provenance": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "enum": ["authoritative", "derived", "observed", "learned"]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "object",
          "properties": {
            "surface": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": ["web", "desktop", "mobile", "service", "game", "device"]
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            "instance": {
              "type": "string",
              "minLength": 1
            },
            "epoch": {
              "type": "integer",
              "minimum": 0
            },
            "locator": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "required": ["surface", "instance"],
          "additionalProperties": false
        },
        "at": {
          "type": "integer"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["class", "source", "method", "subject", "at"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
