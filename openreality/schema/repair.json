{
  "$id": "https://openreality.dev/schema/v1/repair.json",
  "$ref": "#/definitions/repair",
  "definitions": {
    "repair": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "actual": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "location": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer"
            },
            "symbol": {
              "type": "string"
            }
          },
          "required": ["file"],
          "additionalProperties": false
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["verdict", "expected", "actual", "evidence", "instruction"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
