{
  "name": "open-verification",
  "version": "1.0.0",
  "description": "The Open Verification Protocol: the vocabulary, the rules and the interface an implementation answers, so that \"it works\" can be checked from outside the thing claiming it.",
  "keywords": [
    "verification",
    "protocol",
    "specification",
    "conformance",
    "ai-agents",
    "reticle"
  ],
  "homepage": "https://github.com/reticlehq/reticle#readme",
  "bugs": "https://github.com/reticlehq/reticle/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reticlehq/reticle.git",
    "directory": "open-verification"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/*.json": "./dist/schema/*.json",
    "./vectors/*.json": "./vectors/*.json"
  },
  "files": [
    "dist",
    "README.md",
    "SPEC.md",
    "GOVERNANCE.md",
    "vectors",
    "CONFORMANCE.md",
    "SECURITY.md",
    "VERSIONING.md",
    "EXTENSIONS.md",
    "CHANGELOG.md",
    "CHANGE-PROCESS.md",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && node ../scripts/alias-dist.mjs && node scripts/gen-schema.mjs",
    "prepack": "node ../scripts/prepare-dist.mjs --clean dist && tsc -b --force && node ../scripts/alias-dist.mjs && node scripts/gen-schema.mjs && node ../scripts/prepare-dist.mjs dist",
    "test:unit": "vitest run --passWithNoTests",
    "test:guards": "node ../scripts/guard-tests.mjs guards"
  },
  "dependencies": {
    "zod": "3.22.4"
  },
  "devDependencies": {
    "zod-to-json-schema": "3.22.4"
  }
}
