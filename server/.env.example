# Reticle bridge + MCP server configuration

# Port the bridge WebSocket endpoint + MCP server listen on.
RETICLE_PORT=4400

# Keep the default loopback bind unless remote browser access is intentional.
RETICLE_HOST=127.0.0.1

# Shared pairing token between the browser SDK and the bridge.
# Generate one and set the same value in the app's @reticlehq/browser config.
# Leave blank in pure-localhost dev; required for any non-localhost transport.
# Terminate TLS in front of the bridge and use wss:// from browsers when it is remote.
RETICLE_TOKEN=

# Comma-separated browser origins allowed in addition to localhost.
RETICLE_ALLOWED_ORIGINS=

# Needed only by `reticle_verify { action: "explore" }` and `reticle verify --explore`, where a model
# inside the daemon drives the app so the drive stops costing your agent's context. Absent, those two
# refuse and say so; nothing else in Reticle reads it, and no verdict is ever decided by a model.
ANTHROPIC_API_KEY=

# Enterprise licence key, issued by hey@reticle.sh. Absent, every non-enterprise feature works.
RETICLE_LICENSE_KEY=

# Attach to a Chrome you started with --remote-debugging-port instead of launching one,
# e.g. http://127.0.0.1:9222.
RETICLE_CDP_URL=

# 1 advertises every registered tool instead of the default ten. Read once when the daemon starts.
RETICLE_ADVERTISE_ALL_TOOLS=

# 0 turns off anonymous usage telemetry (DO_NOT_TRACK=1 does too). See docs/telemetry.md.
RETICLE_TELEMETRY=
