{
  "name": "@reticlehq/cloudflare",
  "version": "2.9.0",
  "description": "Self-hosted Reticle verify:server backend for Cloudflare Workers and Browser Rendering.",
  "type": "module",
  "bin": {
    "reticle-cloudflare": "./scripts/bootstrap.mjs"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "pnpm build && wrangler dev --remote",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc -b",
    "lint": "eslint src scripts",
    "test:unit": "vitest run src scripts --passWithNoTests",
    "test:coverage": "vitest run src --passWithNoTests --coverage.enabled --coverage.provider=v8 --coverage.reporter=text-summary --coverage.include='src/**/*.ts' --coverage.exclude='src/**/*.test.ts'",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "rm -rf dist && tsc -b --force && find dist -name \"*.test.*\" -delete && node ../../scripts/strip-maps.mjs dist"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.3.6",
    "@reticlehq/core": "workspace:*",
    "wrangler": "^4.125.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260821.1"
  },
  "files": [
    "dist",
    "scripts/bootstrap.mjs",
    "scripts/bootstrap-lib.mjs",
    "scripts/smoke.mjs",
    "wrangler.jsonc",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reticlehq/reticle.git",
    "directory": "packages/cloudflare"
  },
  "engines": {
    "node": ">=22.12"
  }
}
