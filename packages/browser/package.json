{
  "name": "@reticlehq/browser",
  "version": "2.3.0",
  "description": "Reticle browser SDK — installs observers, builds semantic snapshots, executes actions, talks to the bridge.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "test:unit": "vitest run src --passWithNoTests",
    "prepack": "tsc -b && find dist -name \"*.test.*\" -delete && node ../../scripts/strip-maps.mjs dist"
  },
  "dependencies": {
    "@reticlehq/core": "workspace:*",
    "@testing-library/dom": "^10.4.1"
  },
  "devDependencies": {
    "@tanstack/query-core": "^5.101.4",
    "@types/jsdom": "^28.0.3",
    "jotai": "^2.20.2",
    "jsdom": "^30.0.1",
    "mobx": "^7.0.0",
    "pinia": "^4.0.2",
    "react": "^19.2.8",
    "recoil": "^0.7.7",
    "svelte": "^5.56.8",
    "valtio": "^2.3.2",
    "vue": "^3.5.41",
    "xstate": "^5.32.5"
  },
  "license": "Apache-2.0",
  "author": "Reticle contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reticlehq/reticle.git",
    "directory": "packages/browser"
  },
  "homepage": "https://github.com/reticlehq/reticle#readme",
  "bugs": "https://github.com/reticlehq/reticle/issues",
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "sideEffects": false,
  "keywords": [
    "mcp",
    "ai-agents",
    "testing",
    "instrumentation",
    "observability"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
